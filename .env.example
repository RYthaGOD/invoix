# Invoix System Configuration (.env)

# --- SERVER CONFIG ---
PORT=5000
NODE_ENV=production
API_URL=https://api.solanainvoice.com
SESSION_SECRET=your_super_secret_session_key_here
STRICT_SESSION=true # Fail if persistent store is missing

# --- DATABASE CONFIG ---
DATABASE_URL=postgres://user:password@localhost:5432/invoix

# --- SOLANA CONFIG ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet # or mainnet-beta
PLATFORM_TREASURY_WALLET=your_treasury_wallet_here
PAYER_PRIVATE_KEY=[1,2,3...] # Array of numbers or bs58 string for NFT minting authority

# --- NFT SERVICE CONFIG ---
MERKLE_TREE_ADDRESS=your_merkle_tree_address_here
GENESIS_COLLECTION_MINT=your_collection_mint_here
NFT_STORAGE_API_KEY=your_irys_or_nft_storage_key

# --- ARCIUM (TEE) CONFIG ---
# Arcium Program ID (MXE)
ARCIUM_PROGRAM_ID=MXE...
# Private key for the Arcium Service (Authorized Payer/User)
# This should be a Keypair used for encryption/decryption requests
ARCIUM_PRIVATE_KEY=[1,2,3...] 

# --- EXTERNAL SERVICES ---
RESEND_API_KEY=re_...
STRIPE_SECRET_KEY=sk_test_...

# --- ADMIN CONFIG ---
ADMIN_WALLET=your_admin_wallet_for_reserved_mints
ADMIN_SECRET=your_admin_api_secret

# --- FRONTEND CONFIG (VITE) ---
# These are exposed to the frontend and should be prefixed with VITE_
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet

# --- LAZORKIT (PASSKEY AUTH) CONFIG ---
# Enable passkey authentication (opt-in for production)
VITE_ENABLE_PASSKEY_AUTH=false
# LazorKit RPC endpoint for smart wallet operations
VITE_LAZORKIT_RPC_URL=https://api.devnet.solana.com
# Portal URL for WebAuthn credential management
VITE_LAZORKIT_PORTAL_URL=https://portal.lazor.sh
# Paymaster URL for gasless transactions (devnet default)
VITE_LAZORKIT_PAYMASTER_URL=https://kora.devnet.lazorkit.com
# LazorKit smart wallet program ID (for signature verification)
LAZORKIT_PROGRAM_ID=Lazor1111111111111111111111111111111111111111

# --- FEATURE FLAGS ---
# Skip x402 payment check for local dev/testing
SKIP_FEE_CHECK=false 
# Enable structured logging
LOG_FORMAT=json
# Fallback SOL price (USD) if CoinGecko API is unavailable
SOL_PRICE_FALLBACK=100
# Gas fee for payment relay (USDC)
GAS_FEE_USDC=0.15

# --- MONITORING ---
# Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/project-id

# --- JOB QUEUE (OPTIONAL) ---
# Redis URL for BullMQ job queue (webhooks, emails)
# If not set, webhooks and emails will run synchronously (default behavior)
# REDIS_URL=redis://localhost:6379
