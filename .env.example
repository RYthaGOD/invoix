# SolanaInvoice - B2B Invoicing System Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string (required for production)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/invoix

# SSL Mode for database connection
# Options: disable, require (default: require for non-internal, disable for railway.internal)
# DB_SSL_MODE=require

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================
# Solana RPC endpoint for blockchain interaction
# Public RPC (free, rate limited): https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Premium RPC options (recommended for production):
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/YOUR_KEY/
# Triton: https://your-endpoint.rpcpool.com/YOUR_KEY

# =============================================================================
# SESSION & SECURITY
# =============================================================================
# Session secret for encrypting session cookies (REQUIRED)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
SESSION_SECRET=your-random-secret-here-min-32-chars-use-openssl-rand-base64-32

# Encryption master key for encrypting sensitive data (OPTIONAL for dev, REQUIRED for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 characters (32 bytes hex)
ENCRYPTION_MASTER_KEY=your-64-char-hex-key-here-optional-for-dev-required-for-prod

# =============================================================================
# NFT CONFIGURATION (Optional)
# =============================================================================
# Pre-existing Merkle Tree address for compressed NFTs
# If not provided, a new tree will be created on first NFT mint
# MERKLE_TREE_ADDRESS=your-merkle-tree-address-here

# Maximum tree depth for compressed NFTs (default: 14)
# NFT_TREE_MAX_DEPTH=14

# Maximum buffer size for compressed NFTs (default: 64)
# NFT_TREE_MAX_BUFFER_SIZE=64

# Canopy depth for compressed NFTs (default: 0)
# NFT_TREE_CANOPY_DEPTH=0

# =============================================================================
# ARCIUM CONFIGURATION (Optional - Confidential Computing)
# =============================================================================
# Arcium MXE endpoint for privacy-preserving computation
# ARCIUM_API_ENDPOINT=https://api.arcium.com/v1/mxe

# Arcium API key
# ARCIUM_API_KEY=your-arcium-api-key

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# Application URLs (used for callbacks and metadata)
API_URL=http://localhost:5000
APP_URL=http://localhost:5000

# =============================================================================
# METADATA STORAGE (Optional)
# =============================================================================
# For storing NFT metadata (Arweave, IPFS, etc.)
# ARWEAVE_WALLET_PATH=path/to/arweave-wallet.json
# IPFS_API_ENDPOINT=https://ipfs.infura.io:5001

# =============================================================================
# STABLECOIN CONFIGURATION (Auto-configured)
# =============================================================================
# Stablecoin mint addresses (already configured in shared/stablecoin-config.ts)
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# PYUSD_MINT=2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo
# EURC_MINT=HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr

# =============================================================================
# LOCAL DEVELOPMENT (SQLite)
# =============================================================================
# For local development, you can use SQLite instead of PostgreSQL
# Simply unset DATABASE_URL or run in development mode without it
# SQLite database will be created at: ./data/invoices.db

# =============================================================================
# QUICK START (Minimum Required for Development)
# =============================================================================
# For local development with SQLite:
# 1. SESSION_SECRET (random 32+ characters)
# 2. SOLANA_RPC_URL (or use default public RPC)
#
# For production with PostgreSQL:
# 1. DATABASE_URL (PostgreSQL connection string)
# 2. SESSION_SECRET (random 32+ characters)
# 3. ENCRYPTION_MASTER_KEY (64-character hex string)
# 4. SOLANA_RPC_URL (premium RPC recommended)
#
# Then run:
# npm install
# npm run db:push  # Only for PostgreSQL
# npm run dev
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit the .env file to version control
# 2. Use different keys for development, staging, and production
# 3. Rotate encryption keys periodically
# 4. Store sensitive keys in a secure secret management system
# 5. Use environment variables in CI/CD instead of .env files
# 6. Enable HTTPS in production
# 7. Set strong SESSION_SECRET (min 32 chars)
# 8. ENCRYPTION_MASTER_KEY must be exactly 64 characters (32 bytes hex)
#
# =============================================================================
# MONITORING & DEBUGGING (Optional)
# =============================================================================
# LOG_LEVEL=info
# ENABLE_REQUEST_LOGGING=true
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
