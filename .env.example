# Solana B2B Invoicing System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/invoix

# Database SSL mode (require, disable, prefer)
# Use 'require' for production, 'disable' for local development
DB_SSL_MODE=require

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================
# Solana RPC endpoint for blockchain interaction
# Public RPC (free, rate limited): https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Premium RPC options (recommended for production):
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/YOUR_KEY/
# Triton: https://your-endpoint.rpcpool.com/YOUR_KEY

# Treasury wallet that receives platform fees (1% of all trades)
TREASURY_WALLET_PUBLIC_KEY=jawKuQ3xtcYoAuqE9jyG2H35sv2pWJSzsyjoNpsxG38

# =============================================================================
# ARCIUM ENCRYPTION (OPTIONAL)
# =============================================================================
# Arcium MXE endpoint for multi-party encryption
ARCIUM_MXE_ENDPOINT=https://mxe-mainnet.arcium.com
ARCIUM_PROGRAM_ID=Arc1umRPHMxZ5u8CcVJHCZv5F6DAP7S3RkHvBJmKEWCA
ENABLE_ARCIUM_ENCRYPTION=false

# =============================================================================
# BLOCKCHAIN PRIVATE KEYS (REQUIRED FOR CERTAIN FEATURES)
# =============================================================================
# NFT minting payer (base58 Solana private key)
# Only required if NFT minting is enabled
# NEVER commit this to version control
PAYER_PRIVATE_KEY=

# Enable/disable NFT minting
ENABLE_NFT_MINTING=false

# Bundlr/Arweave for NFT metadata storage (optional)
# BUNDLR_PRIVATE_KEY=
# ARWEAVE_WALLET_JWK=
# IPFS_API_URL=

# =============================================================================
# SESSION & SECURITY (REQUIRED)
# =============================================================================
# Session secret for Express sessions (min 32 characters)
# Generate with: openssl rand -base64 32
# REQUIRED for all environments
SESSION_SECRET=your-random-secret-here-min-32-chars-use-openssl-rand-base64-32

# =============================================================================
# ENCRYPTION (REQUIRED FOR PRODUCTION)
# =============================================================================
# Invoice encryption key - MUST be base64-encoded 32 bytes (44 characters in base64)
# Generate with: openssl rand -base64 32
# OR use passphrase-based derivation (see below)
# REQUIRED for production, optional for development
INVOICE_ENCRYPTION_KEY=

# Alternative: Passphrase-based key derivation
# If INVOICE_ENCRYPTION_KEY is not set, this passphrase will be used with scrypt
# to derive a 32-byte encryption key. Salt must be consistent for same key derivation.
# INVOICE_ENCRYPTION_PASSPHRASE=your-strong-passphrase-here
# INVOICE_ENCRYPTION_SALT=fixed-salt-for-consistent-key-derivation

# Legacy encryption master key (64-character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used for non-invoice data encryption
ENCRYPTION_MASTER_KEY=your-64-char-hex-key-here-optional-for-dev

# =============================================================================
# NFT CONFIGURATION (Optional)
# =============================================================================
# Pre-existing Merkle Tree address for compressed NFTs
# If not provided, a new tree will be created on first NFT mint
# MERKLE_TREE_ADDRESS=your-merkle-tree-address-here

# Maximum tree depth for compressed NFTs (default: 14)
# NFT_TREE_MAX_DEPTH=14

# Maximum buffer size for compressed NFTs (default: 64)
# NFT_TREE_MAX_BUFFER_SIZE=64

# Canopy depth for compressed NFTs (default: 0)
# NFT_TREE_CANOPY_DEPTH=0

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# Application URLs (used for callbacks and metadata)
API_URL=http://localhost:5000
APP_URL=http://localhost:5000

# =============================================================================
# METADATA STORAGE (Optional)
# =============================================================================
# For storing NFT metadata (Arweave, IPFS, etc.)
# ARWEAVE_WALLET_PATH=path/to/arweave-wallet.json
# IPFS_API_ENDPOINT=https://ipfs.infura.io:5001

# =============================================================================
# x402 MICROPAYMENTS (OPTIONAL)
# =============================================================================
# x402 service wallet for receiving micropayment fees
X402_SERVICE_WALLET=
X402_INVOICE_FEE_USD=0.01

# =============================================================================
# STABLECOIN CONFIGURATION (Auto-configured)
# =============================================================================
# Stablecoin mint addresses (already configured in shared/stablecoin-config.ts)
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# PYUSD_MINT=2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo
# EURC_MINT=HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr

# =============================================================================
# LOCAL DEVELOPMENT (SQLite)
# =============================================================================
# For local development, you can use SQLite instead of PostgreSQL
# Simply unset DATABASE_URL or run in development mode without it
# SQLite database will be created at: ./data/invoices.db

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# 1. NEVER commit .env file to version control
# 2. Use different encryption keys for dev/staging/production
# 3. Rotate encryption keys periodically (document rotation schedule)
# 4. Use KMS (AWS KMS, Google Cloud KMS) for production key management
# 5. Store PAYER_PRIVATE_KEY in secure vault, not in .env file
# 6. Enable audit logging for all key access
# 7. Use premium RPC with authentication for production
# 8. Set DB_SSL_MODE=require for production databases
# 9. Monitor for unusual transaction patterns
# 10. Keep dependencies updated (run npm audit regularly)
