# ===========================================
# INVOIX DEVNET DEPLOYMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in the values
# All variables marked [REQUIRED] must be set before deployment

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=production
PORT=5000

# ===========================================
# DATABASE [REQUIRED]
# ===========================================
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# SESSION SECURITY [REQUIRED]
# ===========================================
# Must be at least 32 characters, use: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-min-32-chars

# ===========================================
# SOLANA CONFIGURATION [REQUIRED]
# ===========================================
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury wallet that receives platform fees
# This MUST be set - no fallback in production
PLATFORM_TREASURY_WALLET=your_devnet_treasury_wallet_address

# Keypair for NFT minting and gas sponsorship (base58 private key)
# Generate with: solana-keygen new --outfile keypair.json
# Convert to base58 for this variable
PAYER_PRIVATE_KEY=your_base58_private_key

# ===========================================
# PROGRAM IDS [REQUIRED WHEN FEATURES ENABLED]
# ===========================================
# Set these to deployed devnet program addresses
# Use System Program (11111111111111111111111111111112) for testing if not deployed
MARKETPLACE_PROGRAM_ID=your_marketplace_program_id
ARCIUM_PROGRAM_ID=your_arcium_program_id

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable NFT minting (requires PAYER_PRIVATE_KEY)
ENABLE_NFT_MINTING=true

# Enable Arcium encryption features (requires ARCIUM_PROGRAM_ID)
ENABLE_ARCIUM_ENCRYPTION=false

# ===========================================
# NFT CONFIGURATION
# ===========================================
# Leave empty to auto-create on first run
MERKLE_TREE_ADDRESS=
COLLECTION_MINT_ADDRESS=

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Redis for job queue (optional - falls back to sync processing)
# REDIS_URL=redis://localhost:6379

# Email service (Resend)
# RESEND_API_KEY=re_xxxxxxxxxx

# Error tracking (Sentry)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================================
# FEE CONFIGURATION
# ===========================================
# Platform fee for gasless relay (USDC)
GAS_FEE_USDC=0.15

# SOL price fallback when oracle unavailable
SOL_PRICE_FALLBACK=150

# Invoice service fee in SOL
INVOICE_SERVICE_FEE_SOL=0.001

# ===========================================
# API URLS
# ===========================================
# Your deployment URL (for NFT metadata, callbacks)
# API_URL=https://your-app.railway.app
# APP_URL=https://your-app.railway.app

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Admin wallet for special mints (optional)
# ADMIN_WALLET=your_admin_wallet_address
